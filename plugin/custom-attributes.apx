customAttribute attribute_01 (
    apexlangName: skeleton
    attribute: 1
    name: Skeleton
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 10
        attributeGroup: @sk3Skeleton
    }
    default {
        value: MALE
    }
    help {
        helpText: The skeleton shown first. From Page Item takes it from the patient's record. A saved value remembers the skeleton it was marked on.
    }

    entry male (
        sequence: 10
        display: Male
        return: MALE
    )

    entry female (
        sequence: 20
        display: Female
        return: FEMALE
    )

    entry item (
        sequence: 30
        display: From Page Item
        return: ITEM
    )

)

customAttribute attribute_02 (
    apexlangName: sexItem
    attribute: 2
    name: Sex Item
    type: pageItem
    validation {
        required: true
    }
    appearance {
        sequence: 20
        attributeGroup: @sk3Skeleton
    }
    dependingOn {
        attribute: @attribute_01/component
        conditionType: =
        value: ITEM
    }
    help {
        helpText: The page item with the patient's sex. M/Male and F/Female select the corresponding model. Missing, U, Other and unrecognized values remain U (unconfirmed), with a warning and sex-specific anatomy unavailable. Use a protected item and authorize the patient on the server.
    }
)

customAttribute attribute_03 (
    apexlangName: options
    attribute: 3
    name: Options
    type: checkboxes
    appearance {
        sequence: 30
        attributeGroup: @sk3Skeleton
    }
    default {
        value: MODE_SWITCH:COMPLAINTS:SEARCH:PAIN:NOTE:SPECIALTY_SWITCH
    }
    help {
        helpText: What users see around the skeleton. APEX model sex is controlled by the configured patient source; the legacy Male / Female Switch option is ignored. Area / Bone Switch shows buttons on the skeleton; Common Complaints are the one-tap buttons (Headache, Back pain ...); Search finds complaints, areas, bones and diagnoses; Pain Score is the 0 to 10 scale and Notes a short text for each marked site.
    }

    entry sexSwitch (
        sequence: 10
        display: Male / Female Switch (legacy, ignored in APEX)
        return: SEX_SWITCH
    )

    entry modeSwitch (
        sequence: 20
        display: Area / Bone Switch
        return: MODE_SWITCH
    )

    entry complaints (
        sequence: 30
        display: Common Complaints
        return: COMPLAINTS
    )

    entry search (
        sequence: 40
        display: Search
        return: SEARCH
    )

    entry pain (
        sequence: 50
        display: Pain Score
        return: PAIN
    )

    entry note (
        sequence: 60
        display: Notes
        return: NOTE
    )

    entry specialtySwitch (
        sequence: 70
        display: Specialty Switch
        return: SPECIALTY_SWITCH
    )

)

customAttribute attribute_11 (
    apexlangName: specialty
    attribute: 11
    name: Specialty
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 70
        attributeGroup: @sk3Skeleton
    }
    default {
        value: ALL
    }
    help {
        helpText: Select the clinical specialty to control visible anatomy, organ choices, search results and common complaints. Turn off Specialty Switch in Options to keep the configured specialty fixed. Existing saved marks remain in the item value when the view changes. The preset does not supply a diagnosis catalog. Use Diagnosis Query for your specialty's coded diagnoses.
    }

    entry all (
        sequence: 10
        display: General Medicine
        return: ALL
    )
    entry ent (
        sequence: 20
        display: ENT
        return: ENT
    )
    entry ophthalmology (
        sequence: 30
        display: Ophthalmology
        return: OPHTHALMOLOGY
    )
    entry cardiology (
        sequence: 40
        display: Cardiology
        return: CARDIOLOGY
    )
    entry urology (
        sequence: 50
        display: Urology
        return: UROLOGY
    )
    entry internalMedicine (
        sequence: 60
        display: Internal Medicine
        return: INTERNAL_MEDICINE
    )
    entry gastroenterology (
        sequence: 70
        display: Gastroenterology
        return: GASTROENTEROLOGY
    )
    entry neurology (
        sequence: 80
        display: Neurology
        return: NEUROLOGY
    )
    entry pulmonology (
        sequence: 90
        display: Pulmonology
        return: PULMONOLOGY
    )
    entry orthopedics (
        sequence: 100
        display: Orthopedics
        return: ORTHOPEDICS
    )
)

customAttribute attribute_12 (
    apexlangName: anatomyLayer
    attribute: 12
    name: Initial View
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 80
        attributeGroup: @sk3Skeleton
    }
    default {
        value: AUTO
    }
    help {
        helpText: Specialty Default uses the preset's initial view. Anatomy shows organs with a translucent skeleton, Skeleton shows bones, and Organs shows soft tissue. Users can switch views without changing their recorded sites.
    }
    entry auto (
        sequence: 10
        display: Specialty Default
        return: AUTO
    )
    entry anatomy (
        sequence: 20
        display: Anatomy
        return: ANATOMY
    )
    entry skeleton (
        sequence: 30
        display: Skeleton
        return: SKELETON
    )
    entry organs (
        sequence: 40
        display: Organs
        return: ORGANS
    )
)

customAttribute attribute_04 (
    apexlangName: selectBy
    attribute: 4
    name: Select By
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 40
        attributeGroup: @sk3Skeleton
    }
    default {
        value: AREA
    }
    help {
        helpText: What a click marks. Area is the easy one - Left knee, Lower back, Chest. Bone marks a single bone, such as the L4 vertebra or the left scaphoid. With the Area / Bone Switch option users can change it.
    }

    entry area (
        sequence: 10
        display: Area
        return: AREA
    )

    entry bone (
        sequence: 20
        display: Bone
        return: BONE
    )

)

customAttribute attribute_05 (
    apexlangName: height
    attribute: 5
    name: Height
    type: integer
    validation {
        required: true
    }
    appearance {
        sequence: 50
        attributeGroup: @sk3Skeleton
    }
    default {
        value: 560
    }
    builder {
        unit: pixels
    }
    help {
        helpText: Height of the 3D view on wide screens, 320 to 1200. On phones the view takes about 60 percent of the screen height and the list follows below it.
    }
)

customAttribute attribute_06 (
    apexlangName: maxSites
    attribute: 6
    name: Maximum Sites
    type: integer
    appearance {
        sequence: 60
        attributeGroup: @sk3Skeleton
    }
    help {
        helpText: The most areas or bones that can be marked. Empty = no limit.
    }
)

customAttribute attribute_07 (
    apexlangName: diagnosisSuggestions
    attribute: 7
    name: Diagnosis Suggestions
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 10
        attributeGroup: @sk3Diagnoses
    }
    default {
        value: BUILTIN
    }
    help {
        helpText: Show suggestions from the application's shared diagnosis table, or hide them. Diagnoses and complaints are maintained in CA3D_CLINIC_TERMS with anatomy links in CA3D_TERM_AREAS. Every item shares this base. Install @db/install.sql first.
    }

    entry builtin (
        sequence: 10
        display: Enabled - shared diagnosis table
        return: BUILTIN
    )


    entry none (
        sequence: 30
        display: Hidden
        return: NONE
    )

)

customAttribute attribute_15 (
    apexlangName: clinicPermissions
    attribute: 15
    name: Clinic Permissions
    type: checkboxes
    appearance {
        sequence: 30
        attributeGroup: @sk3Clinic
    }
    default {
        value: TERMS
    }
    help {
        helpText: Choose the maintenance actions allowed by Shared Catalog Maintainer Condition. Create enables the visible catalog toolbar; select an anatomical site to add a diagnosis or complaint. Configure examination remains available even when Initial Examination is Off. All doctors can select existing shared terms; only authorized maintainers can add or configure them.
    }
    entry option1 (
        sequence: 10
        display: Create clinic diagnoses and complaints
        return: TERMS
    )
    entry option2 (
        sequence: 20
        display: Configure initial examination
        return: EXAM_SETUP
    )
)

